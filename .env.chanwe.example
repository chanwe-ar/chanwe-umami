# chanwe-umami (CHANWE's fork of Polyjapan/umami-sso) — the variables CHANWE's deployment sets.
# `.env.example` is the upstream fork's own sample (kept untouched); it and the README
# document every other Umami/OIDC variable. CHANWE's patches (theme, app shell, sign-out)
# add no variables of their own.
# Real values: the home server's stack .env (chanwe-proxmox-server stacks/umami) and
# chanwe-locker. Names and placeholders only here; never commit a real value.

# --- Core ---
# PostgreSQL connection string; required. # secret
DATABASE_URL=postgresql://umami:password@localhost:5432/umami
# Database engine; optional (postgresql).
DATABASE_TYPE=postgresql
# Key used to sign sessions and hashes; required. # secret
APP_SECRET=
# Key that encrypts stored two-factor secrets, hex; required for 2FA. # secret
TWO_FACTOR_ENCRYPTION_KEY=
# Redis connection string; optional (session cache). # secret
REDIS_URL=
# Port inside the container; the server stack sets 3000.
PORT=3000
# Bind address; the server stack sets 0.0.0.0.
HOSTNAME=0.0.0.0
# Lets Prisma migrate without the advisory lock (read by the Prisma CLI); optional.
PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=

# --- Sign-in through CHANWE Identity (OIDC; enabled when issuer, id and secret are set) ---
# Identity issuer; required for SSO.
OIDC_ISSUER=https://identity.chanwe.ar
# OIDC client id registered on Identity; required for SSO.
OIDC_CLIENT_ID=
# OIDC client secret; required for SSO. # secret
OIDC_CLIENT_SECRET=
# Callback URL; optional (default derived from the request host).
OIDC_REDIRECT_URI=https://umami.chanwe.ar/api/auth/oidc/callback
# Scopes requested; optional (default "openid profile email").
OIDC_SCOPE=
# Claim that carries the roles; optional.
OIDC_ROLES_CLAIM=
# Role mapped to Umami admin; optional (default write).
OIDC_WRITE_ROLE=
# Role given when no role matches; optional.
OIDC_DEFAULT_ROLE=

# --- Carried over from earlier deployments (not read by the current code) ---
# Umami v1 hash salt; unused.
HASH_SALT=
# Public URL; unused by the code.
HOST_URL=
